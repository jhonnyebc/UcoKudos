# Variables de entorno de UcoKudos (ADR-0018, factor III de The Twelve-Factor App).
#
# Copiar como `.env` y rellenar. `.env` NO se versiona.
# Las variables marcadas como SECRETO no tienen valor por omisión en el código:
# si faltan, la aplicación no arranca. Un valor por omisión para un secreto es
# una contraseña en el repositorio con otro nombre.
#
# Puertos elegidos para no chocar con otros entornos locales del autor.

# --- PostgreSQL (ADR-0003) ---
POSTGRES_PUERTO=5435
POSTGRES_USUARIO=ucokudos
POSTGRES_BD=ucokudos
# SECRETO
POSTGRES_PASSWORD=

# --- API (ADR-0016) ---
API_PUERTO=8082
ASPNETCORE_ENVIRONMENT=Development

# --- Identidad por OIDC (ADR-0004) ---
# El emisor y la audiencia no son secretos; el cliente del front tampoco.
IDENTIDAD_EMISOR=
IDENTIDAD_AUDIENCIA=

# --- WhatsApp, Meta Cloud API (ADR-0007) ---
# Proveedor: Simulado (por omisión, sin red) o MetaCloud.
WHATSAPP_PROVEEDOR=Simulado
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERSION_GRAPH=v23.0
# SECRETO: token de usuario del sistema, no el temporal del portal (caduca en horas).
WHATSAPP_ACCESS_TOKEN=

# --- Correo por SMTP (ADR-0008) ---
# En local apunta al contenedor de captura: host=mailpit, puerto=1025, sin credenciales.
SMTP_HOST=localhost
SMTP_PUERTO=1025
SMTP_REMITENTE=no-responder@ucokudos.local
SMTP_USUARIO=
# SECRETO
SMTP_PASSWORD=

# --- Web Push, VAPID (ADR-0009) ---
# La clave pública la necesita el cliente y NO es secreta. La privada sí:
# con ella cualquiera podría enviar notificaciones a los usuarios.
VAPID_ASUNTO=mailto:no-responder@ucokudos.local
VAPID_CLAVE_PUBLICA=
# SECRETO
VAPID_CLAVE_PRIVADA=

# --- Almacenamiento de objetos para adjuntos (ADR-0012) ---
OBJETOS_ENDPOINT=http://localhost:9000
OBJETOS_CONTENEDOR=adjuntos
OBJETOS_USUARIO=ucokudos
# SECRETO
OBJETOS_PASSWORD=

# --- Observabilidad (ADR-0014) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ucokudos-api
OBSERVABILIDAD_PUERTO=18890
