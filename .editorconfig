# Estilo de UcoKudos. Lo verifica `dotnet format --verify-no-changes` en el CI (ADR-0017).
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{sh,bash}]
end_of_line = lf

[*.cs]
# Directivas using fuera del espacio de nombres y ordenadas; System primero.
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Espacio de nombres según la carpeta: evita que un archivo movido quede con el namespace viejo.
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0130.severity = error

# Clean Code: nada de `this.` redundante, tipos del lenguaje y `var` solo cuando el tipo es evidente.
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_predefined_type_for_locals_parameters_members = true:error
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Inmutabilidad por defecto.
dotnet_style_readonly_field = true:error
csharp_prefer_static_local_function = true:suggestion

# Nombres sin usar: se marcan como error para que no se acumulen.
dotnet_diagnostic.IDE0005.severity = error

# Nomenclatura: tipos e integrantes públicos en PascalCase, campos privados con _ delante.
dotnet_naming_rule.tipos_pascal.severity = error
dotnet_naming_rule.tipos_pascal.symbols = tipos
dotnet_naming_rule.tipos_pascal.style = pascal
dotnet_naming_symbols.tipos.applicable_kinds = class,struct,interface,enum,delegate,method,property,event
dotnet_naming_style.pascal.capitalization = pascal_case

# Estas dos reglas van primero: una constante y un campo estático de solo lectura son valores
# fijos, no estado mutable del objeto, así que llevan PascalCase. Sin estas excepciones, la regla
# de abajo les exigiría el guion bajo, que está pensado para el estado de instancia.
dotnet_naming_rule.constantes.severity = error
dotnet_naming_rule.constantes.symbols = constantes
dotnet_naming_rule.constantes.style = pascal
dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.applicable_accessibilities = *
dotnet_naming_symbols.constantes.required_modifiers = const

dotnet_naming_rule.campos_estaticos_fijos.severity = error
dotnet_naming_rule.campos_estaticos_fijos.symbols = campos_estaticos_fijos
dotnet_naming_rule.campos_estaticos_fijos.style = pascal
dotnet_naming_symbols.campos_estaticos_fijos.applicable_kinds = field
dotnet_naming_symbols.campos_estaticos_fijos.applicable_accessibilities = *
dotnet_naming_symbols.campos_estaticos_fijos.required_modifiers = static,readonly

dotnet_naming_rule.campos_privados.severity = error
dotnet_naming_rule.campos_privados.symbols = campos_privados
dotnet_naming_rule.campos_privados.style = guion_bajo
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.guion_bajo.capitalization = camel_case
dotnet_naming_style.guion_bajo.required_prefix = _

[tests/**/*.cs]
# En las pruebas, los nombres descriptivos con guion bajo son más legibles que el PascalCase.
dotnet_naming_rule.tipos_pascal.severity = none
