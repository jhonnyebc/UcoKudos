# Proxy inverso de UCO Kudos (ADR-0016).
#
# Hace tres cosas: termina HTTPS con un certificado que pide y renueva solo, sirve el cliente web
# como archivos estáticos, y pasa a la API todo lo que empiece por /api.
#
# **El cliente y la API comparten origen a propósito.** Así no hay CORS que configurar, y tampoco
# la tentación de abrirlo «mientras tanto», que es como acaban abiertos para siempre.

{$DOMINIO} {
	# El certificado lo gestiona el proxy. El correo es el que recibe los avisos de caducidad.
	tls {$CORREO_TLS}

	encode zstd gzip

	# La API va primero: una ruta de la aplicación nunca empieza por /api, así que no hay ambigüedad.
	handle /api/* {
		reverse_proxy api:8080 {
			# Los avisos en vivo son un flujo que no termina. Sin esto, el proxy esperaría a tener
			# la respuesta completa antes de mandar nada, y el tiempo real dejaría de serlo.
			flush_interval -1
		}
	}

	handle /salud/* {
		reverse_proxy api:8080
	}

	# --- Adjuntos (ADR-0012) -------------------------------------------------------------------
	#
	# El navegador sube y descarga **directo** contra el almacenamiento con URL prefirmadas, y la API
	# firma esas URL contra este mismo dominio. Al quedar en el mismo origen no hace falta CORS.
	#
	# **Esta ruta es estrecha a propósito, y cada condición cierra algo concreto.** El
	# almacenamiento de producción de hoy atiende peticiones anónimas —es una limitación conocida
	# del servidor compatible con S3 que se usa, y la prueba que la comprobaba está omitida con ese
	# motivo—, así que publicarlo sin más dejaría a cualquiera listar el contenedor y leer todos los
	# adjuntos. Se comprobó antes de escribir esto: un GET anónimo al contenedor devolvía el listado
	# completo. Por eso solo pasa lo que lleva una firma:
	#
	#  - La ruta tiene que apuntar a un objeto (`/adjuntos/<algo>`), nunca al contenedor, que es lo
	#    que impide listarlo.
	#  - Solo GET y PUT: ni borrar ni modificar el contenedor.
	#  - Tiene que traer `X-Amz-Signature`. Una petición sin firma ni llega al almacenamiento; una
	#    con firma falsa la rechaza él, que sí valida la firma cuando la hay.
	#
	# El tamaño se acota aquí porque nada más lo hace en el momento de subir: la API solo comprueba
	# el tamaño que *declara* el cliente, y al confirmar lee el objeto entero a memoria. Un archivo
	# de varios gigas subido con una URL válida agotaría la memoria de la API. El máximo del dominio
	# es 5 MiB; el margen es para la cabecera del propio protocolo.
	@adjuntos {
		path_regexp ^/adjuntos/.+
		method GET PUT
		query X-Amz-Signature=*
	}
	handle @adjuntos {
		request_body {
			max_size 6MiB
		}
		reverse_proxy objetos:4566
	}

	# Cualquier otra cosa bajo /adjuntos es un 404 explícito, y no la página de la aplicación, que
	# respondería 200 y haría pensar que el almacenamiento está abierto.
	handle /adjuntos/* {
		respond "No encontrado" 404
	}

	handle {
		root * /srv/web

		# El service worker **no se cachea**: es el archivo que le dice al navegador que hay una
		# versión nueva. Si se cacheara, un usuario podría quedarse con la aplicación vieja para
		# siempre sin que nada pareciera fallar, que es justo lo que ADR-0015 avisa.
		@service_worker path /sw.js /registerSW.js
		header @service_worker Cache-Control "no-cache, no-store, must-revalidate"

		# Los demás archivos llevan el contenido en el nombre, así que se pueden cachear sin miedo.
		@con_huella path /assets/*
		header @con_huella Cache-Control "public, max-age=31536000, immutable"

		# Es una aplicación de una sola página: cualquier ruta desconocida la resuelve el cliente.
		try_files {path} /index.html
		file_server
	}

	# Cabeceras de seguridad. No sustituyen a nada del servidor, pero quitan clases enteras de
	# ataque por unos pocos bytes.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"

		# Quita la cabecera que anuncia qué servidor es: no esconde nada a quien busque de verdad,
		# pero no hace falta regalarlo.
		-Server
	}
}
