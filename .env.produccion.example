# Configuración del servidor (ADR-0016, ADR-0018). Copiar a `.env` EN LA MÁQUINA y rellenar.
#
# Este archivo no se versiona nunca con valores reales. En el servidor debe quedar con permisos
# restringidos, porque contiene todos los secretos de la plataforma:
#
#   chmod 600 .env
#
# Las variables marcadas SECRETO no tienen valor por omisión a propósito: si faltan, la aplicación
# **no arranca**. Un valor por omisión para un secreto es una contraseña en el repositorio con otro
# nombre.

# --- Dominio y certificado ---------------------------------------------------------------------
# El proxy pide el certificado para este nombre. Tiene que resolver a la IP de la máquina ANTES de
# levantar nada, o la autoridad certificadora no podrá comprobarlo y el arranque fallará.
#
# Sin dominio propio sirve un servicio de DNS comodín: por ejemplo `kudos.<IP>.sslip.io`, que
# resuelve solo a esa IP. Es válido para un certificado de verdad.
DOMINIO=
# Dirección donde avisan si el certificado va a caducar.
CORREO_TLS=

# --- Versión desplegada ------------------------------------------------------------------------
# Las escribe el guion de despliegue. Reflejan lo que está corriendo ahora mismo.
VERSION_API=
VERSION_WEB=

# --- Base de datos (ADR-0003) --------------------------------------------------------------------
POSTGRES_USUARIO=ucokudos
POSTGRES_BD=ucokudos
# SECRETO
POSTGRES_PASSWORD=

# --- Identidad (ADR-0004) ------------------------------------------------------------------------
# El emisor lleva barra final: es como viene en el token y la API lo compara tal cual.
IDENTIDAD_EMISOR=
IDENTIDAD_AUDIENCIA=

# --- WhatsApp (ADR-0007) -------------------------------------------------------------------------
# `Simulado` hasta que la plantilla esté aprobada. Cambiar a `MetaCloud` y reiniciar.
WHATSAPP_PROVEEDOR=Simulado
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERSION_GRAPH=v23.0
# SECRETO: token de usuario del sistema, el que no caduca.
WHATSAPP_ACCESS_TOKEN=

# --- Correo (ADR-0008) ---------------------------------------------------------------------------
# Aquí sí hace falta un proveedor real: en el servidor no hay contenedor de captura.
SMTP_PROVEEDOR=Smtp
SMTP_HOST=
SMTP_PUERTO=587
SMTP_TLS=true
SMTP_REMITENTE=
SMTP_USUARIO=
# SECRETO
SMTP_PASSWORD=

# --- Web Push (ADR-0009) -------------------------------------------------------------------------
VAPID_ASUNTO=mailto:
# La pública la necesita el cliente y NO es secreta.
VAPID_CLAVE_PUBLICA=
# SECRETO: con ella cualquiera podría enviar notificaciones a los usuarios.
VAPID_CLAVE_PRIVADA=

# --- Adjuntos (ADR-0012) -------------------------------------------------------------------------
OBJETOS_PROVEEDOR=S3
OBJETOS_CONTENEDOR=adjuntos
OBJETOS_USUARIO=ucokudos
# SECRETO
OBJETOS_PASSWORD=

# --- Observabilidad (ADR-0014) -------------------------------------------------------------------
OTEL_SERVICE_NAME=ucokudos-api

ASPNETCORE_ENVIRONMENT=Production
